# Application runtime connection. Use invoicepro_app, never postgres.
DATABASE_URL=postgresql://invoicepro_app:replace-with-strong-password@localhost:5432/invoicepro

PORT=3000
NODE_ENV=development

# Public issuer details rendered on generated invoices.
INVOICE_ISSUER_NAME=InvoicePro Demo
INVOICE_ISSUER_EMAIL=billing@example.test
INVOICE_ISSUER_ADDRESS=Your business address
