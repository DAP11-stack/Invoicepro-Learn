# Application runtime connection. Use invoicepro_app, never postgres.
DATABASE_URL=postgresql://invoicepro_app:replace-with-strong-password@localhost:5432/invoicepro

# Migration-only connection. Keep this out of application runtime.
DATABASE_ADMIN_URL=postgresql://postgres:replace-with-postgres-password@localhost:5432/invoicepro

PORT=3000
NODE_ENV=development
